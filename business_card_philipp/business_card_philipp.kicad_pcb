				(size 1.1 1.1)
				(thickness 0.25)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "RF direction coupler:\na 4‑section coupled region (4 × 17.08 mm sections = 68.32 mm)\ntwo parallel coupled microstrip traces (Wc = 1.05 mm, gap G = 0.30 mm)\n50 Ω input/output tapers to wider 50 Ω reference lines (w = 1.15 mm)"
		(at 107.696 86.868 0)
