	(gr_text "RF direction coupler @ 2.445 GHz: 17.08 mm → 4 sections = 68.32 mm\nquarter wave 4‑section arrangement coupling near −20 dB for 50 Ω\nCoupled trace width: Wc ≈ 1.05 mm, Gap main-to-coupled: G ≈ 0.30 mm\n\n"
		(at 177.1396 107.7214 0)
		(layer "B.SilkS")
		(uuid "3779b6b9-2367-434b-8c53-f5035dd9db0e")
		(effects
