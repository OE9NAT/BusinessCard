	(text "Differential ADC with ADC0(PB5) and ADC1(PB2)\nfor gain 1x  MUX[3:0] use 1010\nfor gain 20x MUX[3:0] use 1011\n\npage 135"
		(exclude_from_sim no)
		(at 128.27 96.774 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "30247f9c-fc8e-46fd-b226-9e01f1336b50")
	)
	(text "Diodes are required for limiting the voltage on the\n USB busline to  3.3V and 4.3V.\n"
		(exclude_from_sim no)
		(at 18.288 61.722 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
			(href "https://eecs.sarangan.org/2020/06/27/v-usb-on-attiny45-85-microcontrollers/")
		)
		(uuid "317f56f7-457a-479e-a7fb-310315d3cf83")
	)
	(text "ADC pins for sencing light intencity"
		(exclude_from_sim no)
		(at 139.954 24.638 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "687395a2-a095-418c-a653-e3c9a7735de4")
	)
	(text "U=R*I \nI = (U_supply - U_led)/R = (5V-2V)  / 1k ohm = 3m Amp\nI = U/R = 3V  / 150 ohm = 20m Amp\nI = U/R = 3V  / 162 ohm = 18.5m Amp\nI = U/R = 5V  / 150 ohm = 33m Amp\nI = U/R = 5V  / 162 ohm = 30m Amp\n\n\nbecasue always 2 reistors in series, it ich choosen to tkae 82 ohms\n\nDC Current per I/O Pin ....... 40.0 mA\nDC Current VCC and GND Pins.. 200.0 mA"
		(exclude_from_sim no)
		(at 177.546 100.838 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "69c1aa9e-f710-4541-99ce-ca30ba02cfc8")
	)
	(text "Diode to detect Puls and O2 at the Finger \n\nSequence: \nA ON → sample (n readings) → A OFF → short wait;\nB ON → sample → B OFF;\nambient sample. Repeat.\nYour effective sample rate per LED should stay high\n enough for HR (≥25-50 Hz).\n\nSample rate per LED: ≥50-100 S/s for HR;\nfor SpO2 aim ≥100-200 S/s per wavelength."
		(exclude_from_sim no)
		(at 196.85 24.892 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7b352960-481f-4045-8faf-544b5526895f")
	)
