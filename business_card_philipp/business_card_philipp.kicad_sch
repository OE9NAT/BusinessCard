	(text "Differential ADC with ADC0(PB5) and ADC1(PB2)\nfor gain 1x  MUX[3:0] use 1010\nfor gain 20x MUX[3:0] use 1011\n\npage 135"
		(exclude_from_sim no)
		(at 128.27 96.774 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "30247f9c-fc8e-46fd-b226-9e01f1336b50")
	)
	(text "Diodes are required for limiting the voltage on the\n USB busline to  3.3V and 4.3V.\n"
		(exclude_from_sim no)
		(at 18.288 61.722 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
